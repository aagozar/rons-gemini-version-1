# Copia questo file in .env.local (non viene salvato in git) e compila.

# API key di Resend (https://resend.com → Dashboard → API Keys).
# Senza questa chiave il form contatti riceve i messaggi ma non
# invia nessuna email: la richiesta finisce solo nei log del server.
RESEND_API_KEY=

# Facoltativo. Mittente delle email inviate dal form.
# Senza un dominio verificato su Resend, lascia questo commentato:
# il default "onboarding@resend.dev" funziona subito.
# RESEND_FROM="Rons Gemini <onboarding@resend.dev>"

# Facoltativo, solo per test. Senza un dominio verificato su
# Resend, l'account può inviare solo al proprio indirizzo di
# iscrizione: imposta qui quell'indirizzo per testare l'invio.
# In produzione, con il dominio verificato, NON impostarla: il
# form userà automaticamente salavariaronnie@gmail.com.
# RESEND_TO=tuo-indirizzo-di-iscrizione@resend.com

# URL pubblico del sito (per il link nell'anteprima di condivisione).
# NEXT_PUBLIC_SITE_URL=https://ronsgemini.vercel.app
