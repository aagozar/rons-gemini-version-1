# Copia questo file in .env.local (non viene salvato in git) e compila.

# API key di Resend (https://resend.com → Dashboard → API Keys).
# Senza questa chiave il form contatti riceve i messaggi ma non
# invia nessuna email: la richiesta finisce solo nei log del server.
RESEND_API_KEY=

# Facoltativo. Mittente delle email inviate dal form. Deve stare sul
# dominio verificato su Resend (ronsgemini.com). Se non impostato,
# si usa contatti@ronsgemini.com.
# RESEND_FROM="Rons Gemini <contatti@ronsgemini.com>"

# Facoltativo, solo per test: se impostata, le email vanno a questo
# indirizzo invece che a salavariaronnie@gmail.com. NON impostarla
# in produzione.
# RESEND_TO=

# URL pubblico del sito (per il link nell'anteprima di condivisione).
# NEXT_PUBLIC_SITE_URL=https://ronsgemini.com
